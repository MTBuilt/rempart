# Rempart - Configuration
# Copy this file to .env and adjust values as needed.
# All variables are prefixed with REMPART_ (mapped to Settings fields).

# Server bind address and port
REMPART_HOST=127.0.0.1
REMPART_PORT=8443

# Mock mode: true = simulated data (dev/demo), false = real nftables
REMPART_MOCK_MODE=true

# Path to nft binary (ignored in mock mode)
REMPART_NFT_BINARY=/usr/sbin/nft

# Secret key for session signing (CHANGE IN PRODUCTION)
REMPART_SECRET_KEY=change-me-in-production

# Session TTL in seconds (default 8 hours)
REMPART_SESSION_TTL=28800

# Rollback timeout in seconds
REMPART_ROLLBACK_TIMEOUT=30

# Live polling interval in seconds
REMPART_POLL_INTERVAL=2.0

# Path to auth config (leave empty for auto-detection)
REMPART_AUTH_CONFIG_PATH=
