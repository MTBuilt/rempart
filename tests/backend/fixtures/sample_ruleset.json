{
  "nftables": [
    {
      "metainfo": {
        "version": "1.0.9",
        "release_name": "Old Doc Yak #3",
        "json_schema_version": 1
      }
    },
    {
      "table": {
        "family": "inet",
        "name": "filter",
        "handle": 1
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "filter",
        "name": "input",
        "handle": 1,
        "type": "filter",
        "hook": "input",
        "prio": 0,
        "policy": "drop"
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "filter",
        "name": "forward",
        "handle": 2,
        "type": "filter",
        "hook": "forward",
        "prio": 0,
        "policy": "drop"
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "filter",
        "name": "output",
        "handle": 3,
        "type": "filter",
        "hook": "output",
        "prio": 0,
        "policy": "accept"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 4,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "ct": { "key": "state" } },
              "right": ["established", "related"]
            }
          },
          { "accept": null }
        ],
        "comment": "Allow established connections"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 5,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "meta": { "key": "iifname" } },
              "right": "lo"
            }
          },
          { "accept": null }
        ],
        "comment": "Allow loopback"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 6,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "payload": { "protocol": "tcp", "field": "dport" } },
              "right": 22
            }
          },
          {
            "counter": {
              "packets": 1520,
              "bytes": 98304
            }
          },
          { "accept": null }
        ],
        "comment": "Allow SSH"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 7,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "payload": { "protocol": "tcp", "field": "dport" } },
              "right": { "set": [80, 443] }
            }
          },
          {
            "counter": {
              "packets": 45230,
              "bytes": 32567890
            }
          },
          { "accept": null }
        ],
        "comment": "Allow HTTP/HTTPS"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 8,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "payload": { "protocol": "icmp", "field": "type" } },
              "right": "echo-request"
            }
          },
          {
            "limit": {
              "rate": 5,
              "per": "second"
            }
          },
          { "accept": null }
        ],
        "comment": "Allow ping with rate limit"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "filter",
        "chain": "input",
        "handle": 9,
        "expr": [
          {
            "counter": {
              "packets": 3847,
              "bytes": 234521
            }
          },
          {
            "log": {
              "prefix": "INPUT_DROP: ",
              "level": "warn"
            }
          },
          { "drop": null }
        ],
        "comment": "Log and drop everything else"
      }
    },
    {
      "set": {
        "family": "inet",
        "table": "filter",
        "name": "blacklist",
        "handle": 10,
        "type": "ipv4_addr",
        "flags": ["interval", "timeout"],
        "timeout": 3600,
        "elem": [
          "192.168.1.100",
          "10.0.0.50",
          {
            "prefix": {
              "addr": "172.16.0.0",
              "len": 24
            }
          }
        ]
      }
    },
    {
      "table": {
        "family": "ip",
        "name": "nat",
        "handle": 2
      }
    },
    {
      "chain": {
        "family": "ip",
        "table": "nat",
        "name": "postrouting",
        "handle": 4,
        "type": "nat",
        "hook": "postrouting",
        "prio": 100,
        "policy": "accept"
      }
    },
    {
      "rule": {
        "family": "ip",
        "table": "nat",
        "chain": "postrouting",
        "handle": 10,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "meta": { "key": "oifname" } },
              "right": "eth0"
            }
          },
          { "masquerade": null }
        ]
      }
    },
    {
      "chain": {
        "family": "ip",
        "table": "nat",
        "name": "prerouting",
        "handle": 5,
        "type": "nat",
        "hook": "prerouting",
        "prio": -100,
        "policy": "accept"
      }
    },
    {
      "rule": {
        "family": "ip",
        "table": "nat",
        "chain": "prerouting",
        "handle": 11,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "payload": { "protocol": "tcp", "field": "dport" } },
              "right": 8080
            }
          },
          {
            "dnat": {
              "addr": "192.168.1.10",
              "port": 80
            }
          }
        ],
        "comment": "Forward port 8080 to internal web server"
      }
    },
    {
      "table": {
        "family": "inet",
        "name": "rate_limiter",
        "handle": 3
      }
    },
    {
      "set": {
        "family": "inet",
        "table": "rate_limiter",
        "name": "ssh_bruteforce",
        "handle": 20,
        "type": "ipv4_addr",
        "flags": ["timeout"],
        "timeout": 300,
        "size": 1024,
        "elem": [
          "203.0.113.45",
          "198.51.100.12",
          "192.0.2.88",
          "100.64.0.33",
          "172.20.10.5"
        ]
      }
    },
    {
      "set": {
        "family": "inet",
        "table": "rate_limiter",
        "name": "allowed_countries",
        "handle": 21,
        "type": "ipv4_addr",
        "flags": ["interval"],
        "elem": [
          { "prefix": { "addr": "5.0.0.0", "len": 8 } },
          { "prefix": { "addr": "62.0.0.0", "len": 8 } },
          { "prefix": { "addr": "78.0.0.0", "len": 8 } },
          { "prefix": { "addr": "80.0.0.0", "len": 8 } },
          { "prefix": { "addr": "90.0.0.0", "len": 8 } },
          { "prefix": { "addr": "176.0.0.0", "len": 8 } }
        ]
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "rate_limiter",
        "name": "ssh_protection",
        "handle": 22,
        "type": "filter",
        "hook": "input",
        "prio": -10,
        "policy": "accept"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "rate_limiter",
        "chain": "ssh_protection",
        "handle": 23,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "payload": { "protocol": "tcp", "field": "dport" } },
              "right": 22
            }
          },
          {
            "match": {
              "op": "==",
              "left": { "ct": { "key": "state" } },
              "right": "new"
            }
          },
          {
            "limit": {
              "rate": 3,
              "per": "minute"
            }
          },
          {
            "counter": {
              "packets": 847,
              "bytes": 50820
            }
          },
          { "accept": null }
        ],
        "comment": "SSH rate limit: 3 new connections per minute"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "rate_limiter",
        "chain": "ssh_protection",
        "handle": 24,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "payload": { "protocol": "tcp", "field": "dport" } },
              "right": 22
            }
          },
          {
            "match": {
              "op": "==",
              "left": { "ct": { "key": "state" } },
              "right": "new"
            }
          },
          {
            "counter": {
              "packets": 2156,
              "bytes": 129360
            }
          },
          {
            "log": {
              "prefix": "SSH_BRUTE: ",
              "level": "warn"
            }
          },
          { "drop": null }
        ],
        "comment": "Log and drop SSH brute force attempts"
      }
    },
    {
      "chain": {
        "family": "inet",
        "table": "rate_limiter",
        "name": "http_throttle",
        "handle": 25,
        "type": "filter",
        "hook": "input",
        "prio": -5,
        "policy": "accept"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "rate_limiter",
        "chain": "http_throttle",
        "handle": 26,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "payload": { "protocol": "tcp", "field": "dport" } },
              "right": { "set": [80, 443] }
            }
          },
          {
            "match": {
              "op": "==",
              "left": { "ct": { "key": "state" } },
              "right": "new"
            }
          },
          {
            "limit": {
              "rate": 50,
              "per": "second",
              "burst": 100
            }
          },
          { "accept": null }
        ],
        "comment": "HTTP/HTTPS rate limit: 50 new conn/s with burst 100"
      }
    },
    {
      "rule": {
        "family": "inet",
        "table": "rate_limiter",
        "chain": "http_throttle",
        "handle": 27,
        "expr": [
          {
            "match": {
              "op": "==",
              "left": { "payload": { "protocol": "tcp", "field": "dport" } },
              "right": { "set": [80, 443] }
            }
          },
          {
            "match": {
              "op": "==",
              "left": { "ct": { "key": "state" } },
              "right": "new"
            }
          },
          {
            "counter": {
              "packets": 523,
              "bytes": 31380
            }
          },
          { "drop": null }
        ],
        "comment": "Drop HTTP connections exceeding rate limit"
      }
    }
  ]
}
