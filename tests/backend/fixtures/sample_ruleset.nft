flush ruleset

table inet filter {
	set blacklist {
		type ipv4_addr
		flags interval, timeout
		timeout 3600s
		elements = { 192.168.1.100, 10.0.0.50, 172.16.0.0/24 }
	}
	chain input {
		type filter hook input priority 0; policy drop;
		ct state { established, related } accept comment "Allow established connections"
		meta iifname lo accept comment "Allow loopback"
		tcp dport 22 counter accept comment "Allow SSH"
		tcp dport { 80, 443 } counter accept comment "Allow HTTP/HTTPS"
		icmp type echo-request limit rate 5/second accept comment "Allow ping with rate limit"
		counter log prefix "INPUT_DROP: " level warn drop comment "Log and drop everything else"
	}
	chain forward {
		type filter hook forward priority 0; policy drop;
	}
	chain output {
		type filter hook output priority 0; policy accept;
	}
}

table ip nat {
	chain postrouting {
		type nat hook postrouting priority 100; policy accept;
		meta oifname eth0 masquerade
	}
	chain prerouting {
		type nat hook prerouting priority -100; policy accept;
		tcp dport 8080 dnat to 192.168.1.10:80 comment "Forward port 8080 to internal web server"
	}
}
